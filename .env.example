# Copiez vers .env — ne committez jamais .env ni de vraies clés dans .env.example.

# Interface HTTP du projet Supabase (obligatoire pour le frontend / REST)
# Format : https://xxxxxxxx.supabase.co  (PAS une URI postgres)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=

# Connexion Postgres directe (optionnel — outillage local uniquement).
# Dashboard Supabase → Project Settings → Database → Connection string (URI)
DATABASE_URL=

# Jamais dans le frontend
SUPABASE_SERVICE_ROLE_KEY=

# URL publique utilisée par paydunya-checkout (return_url / cancel_url).
# Exemple production : https://shopsenegal.onrender.com
SITE_PUBLIC_URL=https://shopsenegal.onrender.com

PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_SANDBOX=true
PAYDUNYA_CHECKOUT_SECRET=

# Livraison et parrainage (seuils FCFA, affichés au checkout)
SHOPSENEGAL_DELIVERY_THRESHOLD_FCFA=20000
SHOPSENEGAL_DELIVERY_FLAT_FCFA=1000
SHOPSENEGAL_DELIVERY_PERCENT=6
SHOPSENEGAL_REFERRAL_CREDIT_THRESHOLD_FCFA=5500
SHOPSENEGAL_REFERRAL_CREDIT_AMOUNT=300
